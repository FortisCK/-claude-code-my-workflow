# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
# .vscode/settings.json ships in the template (carries shipped Claude Code permission-mode
# recommendations — see TROUBLESHOOTING.md "Permissions / bypass / statusline" for the typo
# fix forkers need). Other .vscode/ content is developer-machine-specific.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Quarto rendering artifacts
.quarto/

# External third-party repos cloned for reference / baseline reproduction
# (TT-U-Net, HM-EDM, etc. — each has its own .git, big checkpoints, datasets).
# Notes about these go in explorations/notes/, not in their own .git.
external/

# quality_reports/ — per-project session logs, plans, specs, merges.
#
# Template behaviour: ignore all per-project content so forks start clean.
# This project (cardiac-artifacts) OVERRIDES that behaviour — we WANT
# spec / plan / decision-record / session-log to sync between Mac↔LTSI
# via git, otherwise the dual-session workflow (per MEMORY.md "Mac↔LTSI
# 双 session 工作流") breaks: LTSI session would `git pull` and miss
# the master spec, plans, and decision records.
#
# Override below: keep .md docs tracked, but still ignore large generated
# artifacts (auto-generated quality reports, R outputs, big binaries
# above 50MB if any).
#!quality_reports/**/*.md
#!quality_reports/**/*.html
#!quality_reports/**/*.pdf
# (no patterns ignored — track everything under quality_reports/)

# R analysis outputs (generated artifacts; keep scripts, ignore outputs)
scripts/R/_outputs/

# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds

# ==============================================================================
# Cardiac-artifacts project: generated / large / per-machine artifacts
# ==============================================================================

# Pip editable-install metadata (regenerated by `pip install -e .`)
*.egg-info/

# Preprocessed dataset cache (large, regenerable; 1 case ~8 MB → 1000 ≈ 8 GB)
data/imagecas/processed/

# Training outputs (binary checkpoints, large, regenerable)
experiments/checkpoints/

# Smoke / generated run artifacts (regenerable; force-add real-run records)
experiments/runs/eval_v1/
experiments/runs/*/smoke/

# Exploration outputs (NIfTI corrupted volumes are ~225 MB each;
# segmentation workdirs are also large)
explorations/**/output/
explorations/**/output_v*/
