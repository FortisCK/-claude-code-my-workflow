# .dockerignore — ALLOWLIST. NOTE: .dockerignore does NOT read .gitignore, so the
# 90G datasets/ and 33G outputs/ would otherwise be sent to the build context.
# Strategy: exclude everything, then re-include only what the inference image needs
# plus the exact champion weight files. (Nested re-include relies on BuildKit;
# verify once docker is installed — build is currently UNVERIFIED.)
**

# Code, configs, packaging metadata
!pyproject.toml
!src/**
!scripts/**
!configs/**

# Task 1 champion: the 7 Stage9A ensemble checkpoints (outputs/ otherwise excluded)
!outputs/task1/smp_fpn_convnext_tiny_640_rescue_stable/best_checkpoint.pt
!outputs/task1/smp_unet_efficientnet_b3_512_shootout/best_checkpoint.pt
!outputs/task1/smp_fpn_convnextv2_base_512_stage4a/best_checkpoint.pt
!outputs/task1/smp_fpn_convnext_small_512_stage4a/best_checkpoint.pt
!outputs/task1/smp_fpn_convnext_small_640_stage5/best_checkpoint.pt
!outputs/task1/smp_fpn_convnext_small_640_cldice_stage6/best_checkpoint.pt
!outputs/task1/smp_fpn_convnext_small_640_toolness_aux_stage7/best_checkpoint.pt

# Task 2 champion: YOLO proposal + tip localizer + quality ranker weights
!outputs/task2/yolo_stage2l_proposal/yolo11s_1024_agnostic_train_v0_v1_val_v2_combined_bal_e20/weights/best.pt
!outputs/task2/sequence_tip_localizer/stage2x_class1_tip384_convnext_centernet_coord20_e8/checkpoints/best.pt
!outputs/task2/stage2u_quality_ranker/stage2u_warm_stage2o_fulltrain_valid512_e6/checkpoints/best.pt

# Never ship these even if a rule above would match
.git/**
**/__pycache__/**
**/*.pyc
